{
  "$id": "RTS-EXECUTION-CHECKPOINT-V1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 0,
      "type": "integer"
    },
    "authorization_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "latest_event_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "latest_sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "plan_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "RTS-EXECUTION-CHECKPOINT-V1"
    },
    "state": {
      "type": "string"
    },
    "usage": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "plan_id",
    "plan_fingerprint",
    "authorization_fingerprint",
    "latest_sequence",
    "latest_event_hash",
    "state",
    "attempt",
    "usage"
  ],
  "type": "object"
}
